# Copy this file to .env and fill in the key. The .env file is never committed.

# Your Claude API key. Needed to run an investigation; everything else works without it.
ANTHROPIC_API_KEY=

# Where captures, uploads and investigation records are stored. Default: ./data
# NETTRIAGE_DATA_DIR=./data

# The trained flow classifier. Default: ./models/flow-classifier
# NETTRIAGE_MODEL_DIR=./models/flow-classifier

# Port the web page and API are published on by docker compose. Default: 8000
# NETTRIAGE_PORT=8000

# Set to 1 wherever strangers can reach the page. A read-only server shows stored
# investigations and accepts no upload and no new investigation, so nobody can spend your key.
# NETTRIAGE_READ_ONLY=1

# Largest upload the server accepts, in megabytes. Default: 200
# NETTRIAGE_MAX_UPLOAD_MB=200

# Extra host names the server answers to, separated by commas. It always answers to
# localhost and 127.0.0.1; any other name is refused unless it is listed here.
# NETTRIAGE_ALLOWED_HOSTS=nettriage.example.org
